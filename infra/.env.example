# Copy to infra/.env.
# Production only (docker-compose.prod.yml): public domain pointing to this server, e.g. sentinela.example.org
DOMAIN=
# SENTINELA_MQTT_PASSWORD is written by `infra/provision.sh backend`.
SENTINELA_MQTT_PASSWORD=
SENTINELA_INPE_ENABLED=true
# SENTINELA_TELEGRAM_BOT_TOKEN=
# SENTINELA_TELEGRAM_CHAT_ID=
# DASHBOARD_PORT=8080
